# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# SQLite by default; switch to PostgreSQL in production
DATABASE_URL=sqlite+pysqlite:///cargo.db
# DATABASE_URL=postgresql+psycopg://cargo:cargo@localhost:5432/cargo

# Comma-separated Telegram user IDs allowed to run /admin_stats
ADMIN_IDS=123456789

CURRENCY=$
MAX_WEIGHT_KG=10000
